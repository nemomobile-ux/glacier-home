[Unit]
Description=Glacier Home UX
Requires=dbus.socket graphical-session-pre.target dconf.service profiled.service
After=pre-user-session.target

[Service]
Type=notify
EnvironmentFile=-/usr/share/glacier-home/nemovars.conf
EnvironmentFile=-/var/lib/environment/compositor/*.conf
ExecStart=/usr/bin/lipstick $LIPSTICK_OPTIONS --systemd
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=user-session.target
